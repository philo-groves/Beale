{
  "name": "beale",
  "productName": "Beale",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Beale authorized vulnerability research workbench",
  "main": "out/main/index.js",
  "scripts": {
    "brand:electron": "node scripts/brand-electron.mjs",
    "postinstall": "npm run brand:electron",
    "prestart": "npm run brand:electron",
    "start": "electron out/main/index.js",
    "predev": "npm run brand:electron",
    "dev": "electron-vite dev",
    "prepreview": "npm run brand:electron",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"tests/{agent-plugin-registry,beale-introspection-server,beale-introspection-tools,honeycrisp-session-boundary,memory-dreaming-model,research-profile-integration,research-profile-persistence,source-materializer}.test.ts\"",
    "test:integration": "vitest run --fileParallelism=false --testTimeout=30000 tests/agent-plugin-registry.test.ts tests/beale-introspection-server.test.ts tests/beale-introspection-tools.test.ts tests/honeycrisp-session-boundary.test.ts tests/memory-dreaming-model.test.ts tests/research-profile-integration.test.ts tests/research-profile-persistence.test.ts tests/source-materializer.test.ts",
    "test:all": "npm run test && npm run test:integration",
    "test:architecture": "vitest run tests/architecture-conformance.test.ts",
    "test:openai:live": "BEALE_LIVE_OPENAI_TEST=1 vitest run tests/openai-live.test.ts",
    "build": "npm run typecheck && electron-vite build"
  },
  "dependencies": {
    "katex": "^0.18.4",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.9.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^41.3.0",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  }
}
